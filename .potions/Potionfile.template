# Potions plugin declarations
# Copy this template to $POTIONS_HOME/Potionfile, then uncomment your choices.
# Review every repository and the resolved commit before approving its code.
# Plugin hooks and active shell configuration run with your account permissions.
#
# Install declared plugins interactively with: potions plugin install
# In scripts, review all sources first, then use: potions plugin install --trust
# A failed entry returns an error while successful entries remain installed.
#
# Shelf packages require a current listing and the recorded reviewed commit.
# Discover available packages with: potions plugin search
#
# plugin 'plugin-hello-world'
#
# GitHub sources can select a release tag or branch. Direct installs require
# your own source review and are outside Shelf screening.
#
# plugin 'OWNER/REPOSITORY', tag: 'v1.0.0'
# plugin 'OWNER/REPOSITORY', branch: 'main'
#
# Local plugins link to your working files. Review and validate them too.
# Relative paths are resolved from this Potionfile's directory. Absolute paths
# and ~/ paths are also accepted.
#
# local_plugin './my-plugin'
# local_plugin '~/my-plugins/custom-theme'
#
# Manage installations with potions plugin list, info, activate, deactivate,
# update, uninstall, and status. Open a new Zsh session to load state changes.
# https://github.com/Rynaro/potions/blob/main/plugins/README.md

